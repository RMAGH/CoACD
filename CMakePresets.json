{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "Release",
      "displayName": "Release",
      "inherits": "msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/Zi /O2 /DNDEBUG /GL /arch:AVX2",
        "CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO": "/debug /LTCG",
        "TBB_TEST": false,
        "OPENVDB_CORE_SHARED": false
      }
    },
    {
      "name": "Debug",
      "displayName": "Debug",
      "inherits": "msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebug",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc",
        "CMAKE_CXX_FLAGS_DEBUG": "/Zi /Ob0 /Od /RTC1 /arch:AVX2",
        "TBB_TEST": false,
        "OPENVDB_CORE_SHARED": false
      }
    }
  ]
}